{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "serena-index": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/Areo-RGB/serena-main",
        "serena",
        "start-mcp-server",
        "--context=vscode",
        "--open-web-dashboard=false",
        "--language-backend",
        "IndexMCP"
      ]
    }
  }
}
